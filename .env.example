# Meta Muse Spark 1.3 and SAM 3.1 share the server-only Meta Model API credential.
MODEL_API_KEY=your_meta_model_api_key

# Ordinary field traffic remains explicitly on Meta unless an owner deliberately changes it.
MAJIPROOF_PRIMARY_VISION_PROVIDER=meta
MAJIPROOF_PRIMARY_VISION_MODEL=muse-spark-1.3
MAJIPROOF_SEGMENTATION_PROVIDER=meta
MAJIPROOF_SEGMENTATION_MODEL=sam-3.1
# Keep disabled until the selected partner model has been validated end to end.
MAJIPROOF_ALLOW_EXPERIMENTAL_FIELD_PROVIDER=false

# Optional Muse Spark Open partner credentials. Keep these server-side only.
FIREWORKS_API_KEY=
BASETEN_API_KEY=

# Modal Shared Endpoint requires an endpoint created in your own workspace.
# Use the exact endpoint model/name from that endpoint's request example; do not guess it.
MODAL_PROXY_TOKEN=
MODAL_ENDPOINT_MODEL=
# Keep false until the project's own image-input request example has been verified.
MODAL_IMAGE_INPUT_VERIFIED=false

# Developer workbench inference is explicitly off by default and is development-only.
MAJIPROOF_EXPERIMENTATION_ENABLED=false
